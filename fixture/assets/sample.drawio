<mxfile host="app.diagrams.net">
  <diagram name="Sample" id="sample">
    <mxGraphModel dx="400" dy="200" grid="1" gridSize="8" page="1" pageWidth="400" pageHeight="200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Source" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Page" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="4" style="endArrow=block;html=1;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
